# ============================================================
# NetExpress — environnement de référence
# ============================================================
#
# Ne jamais commiter de vraies clés, mots de passe, URL privées ou coordonnées
# bancaires. Dans Coolify, renseigner ces valeurs dans Environment Variables.
#
# Ce fichier documente le contrat d'environnement attendu par
# netexpress.settings.prod. Les champs marqués OBLIGATOIRE font échouer le
# démarrage lorsqu'ils sont absents ou invalides.

# ------------------------------------------------------------
# Runtime Django / Coolify
# ------------------------------------------------------------
DJANGO_SETTINGS_MODULE=netexpress.settings.prod
PROCESS_TYPE=web
PORT=8000
RUN_MIGRATIONS_ON_START=true
WEB_CONCURRENCY=2
WEB_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# OBLIGATOIRE — au moins 50 caractères, aléatoire, jamais une clé de dev.
DJANGO_SECRET_KEY=

# OBLIGATOIRE — origine HTTPS publique exacte, sans chemin.
SITE_URL=https://www.nettoyageexpresse.fr

# Hôtes additionnels seulement. SITE_URL est ajouté automatiquement.
ALLOWED_HOSTS=nettoyageexpresse.fr
CSRF_TRUSTED_ORIGINS=https://nettoyageexpresse.fr

# ------------------------------------------------------------
# PostgreSQL et Redis — réseau privé Coolify
# ------------------------------------------------------------
# OBLIGATOIRE — PostgreSQL uniquement en production.
# Format : postgresql://user:password@host:5432/database
DATABASE_URL=

# OBLIGATOIRE — Redis sert au cache Django et à Celery.
# Format : redis://host:6379/0 ou rediss://...
REDIS_URL=

# ------------------------------------------------------------
# Email transactionnel Brevo
# ------------------------------------------------------------
# OBLIGATOIRE en production.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=contact@nettoyageexpresse.fr
DEFAULT_FROM_NAME=Nettoyage Express

CONTACT_RECEIVER_EMAIL=n.express@nettoyageexpresse.fr
CONTACT_CC_EMAIL=
TASK_NOTIFICATION_EMAIL=n.express@nettoyageexpresse.fr

# ------------------------------------------------------------
# Cloudflare Turnstile
# ------------------------------------------------------------
# OBLIGATOIRE en production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# Identité légale et facturation
# ------------------------------------------------------------
COMPANY_NAME=Nettoyage Express
COMPANY_TAGLINE=Espaces verts, nettoyage, peinture, bricolage
COMPANY_ADDRESS_LINE1=753, Chemin de la Désirée
COMPANY_ADDRESS_LINE2=97351 Matoury
COMPANY_SIRET=820 474 195 00022
COMPANY_TVA=
COMPANY_PHONE=05 94 30 23 68 / 06 94 46 20 12
COMPANY_EMAIL=contact@nettoyageexpresse.fr
COMPANY_WEBSITE=www.nettoyageexpresse.fr
COMPANY_APE=8130Z
COMPANY_PAYMENT_TERMS=Paiement comptant à réception de facture
COMPANY_PENALTY_RATE=10%

# ------------------------------------------------------------
# Coordonnées bancaires affichées sur les factures
# ------------------------------------------------------------
# OBLIGATOIRE — titulaire et IBAN. L'IBAN est validé au démarrage (modulo 97).
# Ne jamais inscrire le vrai IBAN dans ce fichier versionné.
BANK_ACCOUNT_NAME=Nettoyage Express
BANK_ACCOUNT_NUMBER=

# BIC facultatif : s'il est renseigné, son format est validé au démarrage.
COMPANY_BIC=

# ------------------------------------------------------------
# Stockage persistant
# ------------------------------------------------------------
# Ces chemins doivent être montés sur des volumes persistants dans Coolify.
MEDIA_ROOT=/app/media
PRIVATE_MEDIA_ROOT=/app/private_media

# Cloudinary reste facultatif pour les images publiques uniquement.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
# Worker Celery
# ------------------------------------------------------------
# Pour la ressource worker Coolify, réutiliser le même environnement et changer :
# PROCESS_TYPE=worker
# RUN_MIGRATIONS_ON_START=false
CELERY_QUEUES=celery,messaging,documents,notifications
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=200
